#!/usr/bin/env bash
# Build dist/GhInbox.app from a release build, ad-hoc signed. Installing it is left to the caller.
# Usage: script/build [--revision <commit>]; without one, the checkout's HEAD is recorded.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd -P)"
cd "$root"

revision=""
if [ "${1:-}" = "--revision" ]; then
	revision="${2:?--revision needs a commit}"
elif [ $# -gt 0 ]; then
	echo "usage: script/build [--revision <commit>]" >&2
	exit 2
# A copy without .git (a GitHub zip) records nothing; nor does one unpacked
# inside another repository, whose HEAD would otherwise be recorded.
elif [ "$(git -C "$root" rev-parse --show-toplevel 2>/dev/null)" = "$root" ]; then
	revision="$(git -C "$root" rev-parse HEAD)"
	if [ -n "$(git -C "$root" status --porcelain)" ]; then
		revision="$revision-dirty"
	fi
fi

# For the app's update check: where the source is, and whether it is a git
# checkout to pull into or a downloaded copy to replace with a newer download.
# Only a copy of the public repository checks, which its CFBundleVersion, the
# sync number that repository stamps, tells apart.
kind=copy
if [ "$(git -C "$root" rev-parse --show-toplevel 2>/dev/null)" = "$root" ]; then
	kind=git
fi

swift build -c release --product gh-inbox
binary="$(swift build -c release --show-bin-path)/gh-inbox"
target="$root/dist/GhInbox.app"
# Assembled beside the target and swapped in once signed, so a failed build
# leaves the last app, which may be the one running, whole.
mkdir -p "$root/dist"
staging="$(mktemp -d "$root/dist/.GhInbox.XXXXXX")"
trap 'rm -rf "$staging"' EXIT
app="$staging/GhInbox.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$binary" "$app/Contents/MacOS/gh-inbox"
cp "$root/Resources/Info.plist" "$app/Contents/Info.plist"
# Which commit this bundle was built from, for an installer to compare with its pin.
if [ -n "$revision" ]; then
	plutil -replace SourceRevision -string "$revision" "$app/Contents/Info.plist"
fi
plutil -replace SourceDirectory -string "$root" "$app/Contents/Info.plist"
plutil -replace SourceKind -string "$kind" "$app/Contents/Info.plist"

# The icon set macOS expects, from the 512-pixel source; 512@2x would only upscale it.
iconset="$(mktemp -d)/AppIcon.iconset"
mkdir -p "$iconset"
for size in 16 32 128 256; do
	sips -z "$size" "$size" "$root/assets/icon.png" --out "$iconset/icon_${size}x${size}.png" >/dev/null
	double=$((size * 2))
	sips -z "$double" "$double" "$root/assets/icon.png" --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
cp "$root/assets/icon.png" "$iconset/icon_512x512.png"
iconutil -c icns "$iconset" -o "$app/Contents/Resources/AppIcon.icns"
rm -rf "$(dirname "$iconset")"

codesign --force --options runtime --sign - "$app"
codesign --verify --strict "$app"
rm -rf "$staging/old"
if [ -e "$target" ]; then
	mv "$target" "$staging/old"
fi
mv "$app" "$target" || { mv "$staging/old" "$target"; exit 1; }
echo "$target"
